[safe]
	directory = /Users/malinruwanpathirana/Documents/Self Learning/nextjs/next-auth

[user]
	name = Malin Dhamsara
	email = maliniqrub@gmail.com
	signingkey = 143FAB503791DCCC

[core]
	editor = vim
	autocrlf = input
	ignorecase = false
	pager = delta

[credential]
	helper = store

[credential "https://git.heroku.com"]
	helper = "!heroku git:credentials"

[interactive]
	diffFilter = delta --color-only

[init]
	defaultBranch = main

[delta]
	features = decorations
	navigate = true
	side-by-side = false
	line-numbers = true
	syntax-theme = OneHalfDark
	line-numbers-left-format = "{nm:>4}│"
	line-numbers-right-format = "{np:>4}│"
	line-numbers-left-style = cyan
	line-numbers-right-style = cyan
	line-numbers-minus-style = red
	line-numbers-plus-style = green
	minus-style = "syntax #3f2d3d"
	minus-emph-style = "syntax #763842"
	plus-style = "syntax #283b4d"
	plus-emph-style = "syntax #316172"
	blame-palette = "#1e1e2e #313244 #45475a"
	merge-conflict-begin-symbol = ▼
	merge-conflict-end-symbol = ▲
	merge-conflict-ours-diff-header-style = yellow bold
	merge-conflict-theirs-diff-header-style = yellow bold italic

[delta "decorations"]
	commit-decoration-style = bold yellow box ul
	file-style = bold yellow ul
	file-decoration-style = none
	hunk-header-decoration-style = cyan box ul

[alias]
	lol = log --graph --decorate --pretty=oneline --abbrev-commit --all
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	last = log -1 HEAD --stat
	today = log --since=midnight --author='Malin Dhamsara' --oneline
	branch-name = !git rev-parse --abbrev-ref HEAD
	publish = !git push -u origin $(git branch-name)
	unpublish = !git push origin :$(git branch-name)
	branches = branch -a --sort=-committerdate
	recent = branch --sort=-committerdate --format='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) - %(contents:subject) %(color:green)(%(committerdate:relative))%(color:reset)'
	st = status -sb
	s = status -sb
	cm = commit -m
	ca = commit --amend
	can = commit --amend --no-edit
	d = diff
	dc = diff --cached
	ds = diff --stat
	co = checkout
	cob = checkout -b
	unstage = reset HEAD --
	undo = reset --soft HEAD~1
	stl = stash list
	stp = stash pop
	sts = stash save
	cleanup = !git branch --merged | grep -v '\\*\\|main\\|master\\|develop' | xargs -n 1 git branch -d
	fzf = "!git checkout $(git branch --color=always --all --sort=-committerdate | grep -v HEAD | fzf --height 50% --ansi --no-multi --preview-window right:65% --preview 'git log -n 50 --color=always --date=short --pretty=\"format:%C(auto)%cd %h%d %s\" $(sed \"s/.* //\" <<< {})' | sed \"s/.* //\")"
	fza = "!git add $(git status -s | fzf --multi --preview 'git diff --color=always {2}' | awk '{print $2}')"
	aliases = config --get-regexp alias
	whoami = config user.email

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	default = current

[fetch]
	prune = true
	pruneTags = true

[rebase]
	autoStash = true
	autoSquash = true

[merge]
	tool = nvimdiff
	conflictstyle = diff3

[diff]
	colorMoved = default
	algorithm = histogram

[rerere]
	enabled = true

[column]
	ui = auto

[color]
	ui = auto

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "status"]
	added = green
	changed = yellow
	untracked = red

[help]
	autocorrect = 10

[url "git@github.com:"]
	insteadOf = gh:

[url "git@gitlab.com:"]
	insteadOf = gl:

[merge "npm-merge-driver"]
	name = automatically merge npm lockfiles
	driver = npx npm-merge-driver merge %A %O %B %P
